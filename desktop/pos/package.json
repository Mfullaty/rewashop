{
  "name": "rewashop-desktop-pos",
  "version": "1.2.1",
  "private": true,
  "description": "RewaShop offline Windows point of sale",
  "author": "RewaShop",
  "license": "UNLICENSED",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "dist:win": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux dir",
    "test:integration": "node test/integration.cjs"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0"
  },
  "build": {
    "appId": "com.rewashop.pos",
    "productName": "RewaShop POS",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "artifactName": "RewaShop-POS-${version}-Setup-${arch}.${ext}"
    },
    "portable": {
      "requestExecutionLevel": "user",
      "artifactName": "RewaShop-POS-${version}-Portable-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Office"
    }
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  }
}
